<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk-bundle­manifest voor automatisch laden van de NLCS Legenda-plugin.
  Plaats de map "NlcsLegenda.bundle" (met dit bestand en een submap Contents met
  NlcsLegenda.dll + NlcsLegenda.Core.dll) in:
    %APPDATA%\Autodesk\ApplicationPlugins\
  SeriesMin/SeriesMax R25.0 = AutoCAD/Civil 3D 2025, R25.1 = 2026, R26.0 = 2027.
  Build-Bundle.ps1 zet de juiste waarde per doelversie.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AppVersion="1.13.0"
                    ProductCode="{4C4B0F1A-6C1E-4C7E-9E3A-1F2A3B4C5D6E}"
                    Name="NLCS Legenda"
                    Description="Automatische NLCS-legendagenerator"
                    Author="infracad-helper">
  <CompanyDetails Name="infracad-helper" />
  <Components Description="NLCS Legenda (.NET 8)">
    <RuntimeRequirements OS="Win64"
                         Platform="AutoCAD*"
                         SeriesMin="R25.0"
                         SeriesMax="R25.0" />
    <ComponentEntry AppName="NlcsLegenda"
                    ModuleName="./Contents/NlcsLegenda.dll"
                    AppType=".NET"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="NLCS_LEGENDA">
        <Command Global="NLCSLEGENDA" Local="NLCSLEGENDA" />
        <Command Global="NLCSLEGENDAUPDATE" Local="NLCSLEGENDAUPDATE" />
        <Command Global="NLCSLEGENDAINFO" Local="NLCSLEGENDAINFO" />
        <Command Global="NLCSLEGENDAEXPORT" Local="NLCSLEGENDAEXPORT" />
        <Command Global="NLCSLEGENDABATCH" Local="NLCSLEGENDABATCH" />
        <Command Global="NLCSLEGENDAVIEWPORT" Local="NLCSLEGENDAVIEWPORT" />
        <Command Global="NLCSLEGENDAOPTIES" Local="NLCSLEGENDAOPTIES" />
        <Command Global="NLCSLEGENDAOMSCHRIJVINGEN" Local="NLCSLEGENDAOMSCHRIJVINGEN" />
        <Command Global="NLCSLEGENDATEKST" Local="NLCSLEGENDATEKST" />
        <Command Global="NLCSLEGENDABEHEER" Local="NLCSLEGENDABEHEER" />
        <Command Global="NLCSLEGENDAUITVINKEN" Local="NLCSLEGENDAUITVINKEN" />
        <Command Global="NLCSLEGENDATOEVOEGEN" Local="NLCSLEGENDATOEVOEGEN" />
        <Command Global="NLCSLEGENDASTATUS" Local="NLCSLEGENDASTATUS" />
        <Command Global="NLCSLEGENDAXREFS" Local="NLCSLEGENDAXREFS" />
        <Command Global="NLCSLEGENDAPRESET" Local="NLCSLEGENDAPRESET" />
        <Command Global="NLCSLEGENDACONFIG" Local="NLCSLEGENDACONFIG" />
        <Command Global="NLCSLEGENDATEST" Local="NLCSLEGENDATEST" />
        <Command Global="NLCSLEGENDABATCHTEST" Local="NLCSLEGENDABATCHTEST" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
